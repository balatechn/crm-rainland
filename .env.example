# root .env (shared shortcuts; per-app envs are in apps/*/.env)
DATABASE_URL="postgresql://rainland:rainland@localhost:5432/rainland_crm?schema=public"

# API env vars (set these in Coolify service environment)
WEB_ORIGIN=https://crm.rainlandautocorp.com
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
PORT=4000

# TeleCMI (Telephone module)
TELECMI_APP_ID=33334930
TELECMI_SECRET=your-telecmi-secret-key

# Microsoft SSO (Azure App Registration)
# Backend env vars — set in Coolify service environment
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_TENANT_ID=your-azure-directory-tenant-id
MICROSOFT_ALLOWED_DOMAIN=nationalgroupindia.com

# Frontend env vars — set in Vercel environment variables
# NEXT_PUBLIC_MICROSOFT_CLIENT_ID=your-azure-app-client-id
# NEXT_PUBLIC_MICROSOFT_TENANT_ID=your-azure-directory-tenant-id

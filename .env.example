# root .env (shared shortcuts; per-app envs are in apps/*/.env)
DATABASE_URL="postgresql://rainland:rainland@localhost:5432/rainland_crm?schema=public"

# API env vars (set these in Coolify service environment)
WEB_ORIGIN=https://crm.rainlandautocorp.com
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
PORT=4000

# TeleCMI (Telephone module)
TELECMI_APP_ID=33334930
TELECMI_SECRET=your-telecmi-secret-key
